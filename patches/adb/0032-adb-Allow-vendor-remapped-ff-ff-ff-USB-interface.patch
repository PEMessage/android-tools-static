From 3f3e0ffbd2b1e7599b78cb2b26a2fbbeee4efc9d Mon Sep 17 00:00:00 2001
From: android-tools-static <email@invalid.invalid>
Date: Mon, 9 Nov 2026 19:05:40 +0800
Subject: [PATCH] adb: widen USB interface filter for vendor ff/ff/ff

adb picks its USB transport from the interface triple alone, in
is_adb_interface(); every other interface is skipped *silently*, which is why
`adb devices` can be empty while `lsusb` shows the device. The wire protocol
behind ff/ff/ff is the stock adb protocol -- only the descriptors differ.

Some vendor builds keep the adb wire protocol but renumber the function, so
stock adb (and the prebuilt Google platform-tools) never see the device even
though `lsusb` does. Widen that one predicate only so it also accepts the
vendor-remapped ff/ff/ff function.

---
 client/transport_usb.cpp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/client/transport_usb.cpp b/client/transport_usb.cpp
index d3b4929..ad661e8 100644
--- a/client/transport_usb.cpp
+++ b/client/transport_usb.cpp
@@ -170,10 +170,15 @@ void init_usb_transport(atransport* t, usb_handle* h) {
 bool is_adb_interface(int usb_class, int usb_subclass, int usb_protocol) {
     // ADB over gadget mode and DbC use the same ADB protocol.
     if (usb_protocol == ADB_PROTOCOL && ((usb_class == ADB_CLASS && usb_subclass == ADB_SUBCLASS) ||
-            (usb_class == ADB_DBC_CLASS && usb_subclass == ADB_DBC_SUBCLASS)))
+            (usb_class == ADB_DBC_CLASS && usb_subclass == ADB_DBC_SUBCLASS))) {
         return true;
-    else
-        return false;
+    }
+    // Vendor-remapped adb function: same adb protocol, but the interface is
+    // advertised as ff/ff/ff so that stock platform-tools ignore the device.
+    if (usb_class == 0xff && usb_subclass == 0xff && usb_protocol == 0xff) {
+        return true;
+    }
+    return false;
 }
 
 bool is_libusb_enabled() {
